{
    "name": "business/jwt-rbac-auth",
    "description": "Production-ready JWT Authentication and RBAC for Laravel 12",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0",
        "tymon/jwt-auth": "^2.1",
        "spatie/laravel-permission": "^6.0",
        "predis/predis": "^2.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0"
    },
    "autoload": {
        "psr-4": { "App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/" }
    },
    "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
    "scripts": {
        "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump","@php artisan package:discover --ansi"],
        "post-root-package-install": ["@php -r \"file_exists('.env') || copy('.env.example', '.env');\""],
        "post-create-project-cmd": ["@php artisan key:generate --ansi","@php artisan jwt:secret --ansi"],
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint"
    },
    "extra": { "laravel": { "dont-discover": [] } },
    "config": { "optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
